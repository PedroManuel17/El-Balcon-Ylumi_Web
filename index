<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>El Balcón & Ylumi — Acaxochitlán</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <style>
    /* =============================
       CSS VARIABLES & RESET
    ============================= */
    :root {
      --olive:    #3F5A3C;
      --olive-lt: #546F51;
      --beige:    #E8E1D6;
      --beige-dk: #D6CCBF;
      --gold:     #C9A86A;
      --gold-lt:  #DEC08A;
      --brown:    #2E2A26;
      --brown-lt: #5A4F44;
      --white:    #FDFAF6;
      --shadow:   0 4px 24px rgba(46,42,38,.10);
      --radius:   16px;
      --radius-sm:8px;
      --transition: .3s cubic-bezier(.4,0,.2,1);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; font-size: 16px; }

    body {
      font-family: 'Poppins', sans-serif;
      background: var(--white);
      color: var(--brown);
      overflow-x: hidden;
    }

    h1,h2,h3,h4 { font-family: 'Playfair Display', serif; }

    a { text-decoration: none; color: inherit; }

    img { display: block; max-width: 100%; }

    /* =============================
       SCROLLBAR
    ============================= */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--beige); }
    ::-webkit-scrollbar-thumb { background: var(--olive); border-radius: 3px; }

    /* =============================
       UTILITY
    ============================= */
    .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
    .section-title {
      font-size: clamp(2rem, 5vw, 3rem);
      color: var(--olive);
      position: relative;
      display: inline-block;
      margin-bottom: .5rem;
    }
    .section-title::after {
      content: '';
      display: block;
      width: 60%;
      height: 2px;
      background: var(--gold);
      margin-top: 8px;
    }
    .section-subtitle {
      font-size: .95rem;
      color: var(--brown-lt);
      margin-bottom: 2.5rem;
      font-weight: 300;
      letter-spacing: .04em;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 28px;
      border-radius: 50px;
      border: none;
      font-family: 'Poppins', sans-serif;
      font-size: .9rem;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
      letter-spacing: .04em;
    }
    .btn-primary {
      background: var(--olive);
      color: var(--beige);
    }
    .btn-primary:hover {
      background: var(--olive-lt);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(63,90,60,.3);
    }
    .btn-gold {
      background: var(--gold);
      color: var(--brown);
    }
    .btn-gold:hover {
      background: var(--gold-lt);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(201,168,106,.3);
    }
    .btn-outline {
      background: transparent;
      color: var(--olive);
      border: 2px solid var(--olive);
    }
    .btn-outline:hover {
      background: var(--olive);
      color: var(--beige);
    }

    /* =============================
       FADE-IN ANIMATION
    ============================= */
    .fade-in {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity .6s ease, transform .6s ease;
    }
    .fade-in.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* =============================
       NAVBAR
    ============================= */
    .navbar {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 1000;
      padding: 16px 0;
      background: rgba(232,225,214,.92);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(201,168,106,.2);
      transition: var(--transition);
    }
    .navbar.scrolled {
      padding: 10px 0;
      box-shadow: var(--shadow);
    }
    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .nav-logo {
      font-family: 'Playfair Display', serif;
      font-size: 1.4rem;
      color: var(--olive);
      font-style: italic;
      line-height: 1.1;
    }
    .nav-logo span { color: var(--gold); }
    .nav-links {
      display: flex;
      gap: 28px;
      list-style: none;
    }
    .nav-links a {
      font-size: .85rem;
      font-weight: 500;
      color: var(--brown);
      letter-spacing: .06em;
      text-transform: uppercase;
      transition: color var(--transition);
    }
    .nav-links a:hover { color: var(--olive); }
    .nav-actions { display: flex; align-items: center; gap: 12px; }
    .cart-btn {
      position: relative;
      background: var(--olive);
      color: var(--beige);
      border: none;
      width: 44px; height: 44px;
      border-radius: 50%;
      cursor: pointer;
      font-size: 1.2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
    }
    .cart-btn:hover { background: var(--olive-lt); transform: scale(1.05); }
    .cart-badge {
      position: absolute;
      top: -4px; right: -4px;
      background: var(--gold);
      color: var(--brown);
      border-radius: 50%;
      width: 18px; height: 18px;
      font-size: .65rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      display: none;
    }
    .hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      background: none;
      border: none;
      padding: 4px;
    }
    .hamburger span {
      display: block;
      width: 24px; height: 2px;
      background: var(--brown);
      border-radius: 2px;
      transition: var(--transition);
    }
    .mobile-menu {
      display: none;
      position: fixed;
      top: 70px; left: 0; right: 0;
      background: var(--beige);
      padding: 20px;
      z-index: 999;
      border-bottom: 1px solid var(--beige-dk);
      box-shadow: var(--shadow);
    }
    .mobile-menu.open { display: block; }
    .mobile-menu a {
      display: block;
      padding: 12px 0;
      font-size: .95rem;
      font-weight: 500;
      color: var(--brown);
      border-bottom: 1px solid var(--beige-dk);
      letter-spacing: .04em;
    }
    .mobile-menu a:last-child { border-bottom: none; }

    /* =============================
       HERO
    ============================= */
    .hero {
      min-height: 100svh;
      background: linear-gradient(160deg, #2E2A26 0%, #3F5A3C 55%, #546F51 100%);
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      padding: 100px 0 60px;
    }
    /* Decorative circles */
    .hero::before {
      content: '';
      position: absolute;
      width: 600px; height: 600px;
      border-radius: 50%;
      border: 1px solid rgba(201,168,106,.15);
      top: -100px; right: -100px;
    }
    .hero::after {
      content: '';
      position: absolute;
      width: 300px; height: 300px;
      border-radius: 50%;
      border: 1px solid rgba(201,168,106,.1);
      bottom: 60px; left: 60px;
    }
    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 640px;
    }
    .hero-eyebrow {
      font-size: .75rem;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 500;
      margin-bottom: 16px;
    }
    .hero h1 {
      font-size: clamp(2.6rem, 7vw, 5rem);
      color: var(--beige);
      line-height: 1.1;
      margin-bottom: 20px;
    }
    .hero h1 em { color: var(--gold); font-style: italic; }
    .hero p {
      font-size: 1rem;
      color: rgba(232,225,214,.8);
      font-weight: 300;
      line-height: 1.7;
      margin-bottom: 36px;
      max-width: 480px;
    }
    .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
    /* floating coffee cup decoration */
    .hero-deco {
      position: absolute;
      right: 5%;
      top: 50%;
      transform: translateY(-50%);
      font-size: 14rem;
      opacity: .06;
      user-select: none;
      z-index: 1;
      animation: float 6s ease-in-out infinite;
    }
    @keyframes float {
      0%,100% { transform: translateY(-50%) rotate(-5deg); }
      50%      { transform: translateY(calc(-50% - 20px)) rotate(5deg); }
    }
    .hero-scroll {
      position: absolute;
      bottom: 30px; left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      color: rgba(232,225,214,.5);
      font-size: .7rem;
      letter-spacing: .12em;
      text-transform: uppercase;
      animation: bounce 2s infinite;
    }
    @keyframes bounce {
      0%,100% { transform: translateX(-50%) translateY(0); }
      50%      { transform: translateX(-50%) translateY(8px); }
    }

    /* =============================
       MENU SECTION
    ============================= */
    .menu-section {
      padding: 100px 0 60px;
      background: var(--white);
    }
    .menu-header { margin-bottom: 40px; }
    /* Category tabs */
    .cat-tabs {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 40px;
    }
    .cat-tab {
      padding: 8px 20px;
      border-radius: 50px;
      border: 1.5px solid var(--beige-dk);
      background: transparent;
      font-family: 'Poppins', sans-serif;
      font-size: .8rem;
      font-weight: 600;
      color: var(--brown-lt);
      cursor: pointer;
      transition: var(--transition);
      letter-spacing: .05em;
    }
    .cat-tab.active, .cat-tab:hover {
      background: var(--olive);
      border-color: var(--olive);
      color: var(--beige);
    }
    /* Category section */
    .cat-section { display: none; }
    .cat-section.active { display: block; }
    .cat-title {
      font-size: 1.4rem;
      color: var(--olive);
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .cat-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(to right, var(--gold), transparent);
    }
    /* Product grid */
    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 20px;
      margin-bottom: 50px;
    }
    .product-card {
      background: var(--white);
      border: 1px solid var(--beige-dk);
      border-radius: var(--radius);
      overflow: hidden;
      transition: var(--transition);
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
    }
    .product-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 16px 40px rgba(46,42,38,.12);
    }
    .product-emoji {
      background: linear-gradient(135deg, var(--beige) 0%, var(--beige-dk) 100%);
      text-align: center;
      font-size: 3rem;
      padding: 28px;
      line-height: 1;
    }
    .product-body {
      padding: 18px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .product-name {
      font-family: 'Playfair Display', serif;
      font-size: 1.05rem;
      color: var(--brown);
      margin-bottom: 6px;
    }
    .product-desc {
      font-size: .78rem;
      color: var(--brown-lt);
      font-weight: 300;
      line-height: 1.5;
      margin-bottom: 14px;
      flex: 1;
    }
    .product-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .product-price {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--olive);
      font-family: 'Playfair Display', serif;
    }
    .add-btn {
      background: var(--olive);
      color: var(--beige);
      border: none;
      width: 36px; height: 36px;
      border-radius: 50%;
      font-size: 1.3rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
      line-height: 1;
    }
    .add-btn:hover {
      background: var(--gold);
      color: var(--brown);
      transform: scale(1.1) rotate(90deg);
    }

    /* =============================
       CART SIDEBAR
    ============================= */
    .cart-overlay {
      position: fixed;
      inset: 0;
      background: rgba(46,42,38,.5);
      z-index: 1100;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition);
    }
    .cart-overlay.open { opacity: 1; pointer-events: all; }
    .cart-sidebar {
      position: fixed;
      top: 0; right: -420px;
      width: 420px; max-width: 100vw;
      height: 100svh;
      background: var(--white);
      z-index: 1101;
      display: flex;
      flex-direction: column;
      transition: right .4s cubic-bezier(.4,0,.2,1);
      box-shadow: -8px 0 40px rgba(46,42,38,.15);
    }
    .cart-sidebar.open { right: 0; }
    .cart-head {
      padding: 24px;
      border-bottom: 1px solid var(--beige-dk);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--beige);
    }
    .cart-head h3 {
      font-size: 1.3rem;
      color: var(--olive);
    }
    .cart-close {
      background: none;
      border: none;
      font-size: 1.5rem;
      cursor: pointer;
      color: var(--brown);
      line-height: 1;
      transition: var(--transition);
    }
    .cart-close:hover { transform: rotate(90deg); color: var(--olive); }
    .cart-items {
      flex: 1;
      overflow-y: auto;
      padding: 20px 24px;
    }
    .cart-empty {
      text-align: center;
      padding: 60px 20px;
      color: var(--brown-lt);
    }
    .cart-empty span { font-size: 4rem; display: block; margin-bottom: 16px; }
    .cart-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 0;
      border-bottom: 1px solid var(--beige-dk);
    }
    .cart-item-emoji { font-size: 2rem; width: 44px; text-align: center; }
    .cart-item-info { flex: 1; }
    .cart-item-name { font-size: .9rem; font-weight: 600; color: var(--brown); }
    .cart-item-price { font-size: .8rem; color: var(--olive); font-weight: 500; }
    .cart-item-controls { display: flex; align-items: center; gap: 8px; }
    .qty-btn {
      background: var(--beige);
      border: 1px solid var(--beige-dk);
      width: 28px; height: 28px;
      border-radius: 50%;
      font-size: .9rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
      color: var(--brown);
    }
    .qty-btn:hover { background: var(--olive); color: var(--beige); border-color: var(--olive); }
    .qty-num { font-weight: 700; font-size: .9rem; min-width: 20px; text-align: center; }
    .cart-footer {
      padding: 20px 24px;
      border-top: 1px solid var(--beige-dk);
      background: var(--beige);
    }
    .cart-total-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }
    .cart-total-label { font-size: .85rem; font-weight: 500; color: var(--brown-lt); }
    .cart-total-amount {
      font-family: 'Playfair Display', serif;
      font-size: 1.6rem;
      color: var(--olive);
      font-weight: 700;
    }

    /* =============================
       ORDER MODAL
    ============================= */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(46,42,38,.6);
      z-index: 1200;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .modal-overlay.open { opacity: 1; pointer-events: all; }
    .modal {
      background: var(--white);
      border-radius: var(--radius);
      padding: 40px;
      max-width: 480px;
      width: 100%;
      transform: scale(.9);
      transition: transform .4s cubic-bezier(.4,0,.2,1);
      box-shadow: 0 24px 80px rgba(46,42,38,.25);
    }
    .modal-overlay.open .modal { transform: scale(1); }
    .modal h3 {
      font-size: 1.6rem;
      color: var(--olive);
      margin-bottom: 8px;
    }
    .modal p.modal-sub {
      font-size: .85rem;
      color: var(--brown-lt);
      margin-bottom: 28px;
    }
    .form-group { margin-bottom: 20px; }
    .form-group label {
      display: block;
      font-size: .8rem;
      font-weight: 600;
      color: var(--brown);
      margin-bottom: 6px;
      letter-spacing: .05em;
      text-transform: uppercase;
    }
    .form-group input,
    .form-group select {
      width: 100%;
      padding: 12px 16px;
      border: 1.5px solid var(--beige-dk);
      border-radius: var(--radius-sm);
      font-family: 'Poppins', sans-serif;
      font-size: .9rem;
      color: var(--brown);
      background: var(--beige);
      transition: border-color var(--transition);
      outline: none;
    }
    .form-group input:focus,
    .form-group select:focus { border-color: var(--olive); }
    .modal-order-summary {
      background: var(--beige);
      border-radius: var(--radius-sm);
      padding: 16px;
      margin-bottom: 24px;
      max-height: 180px;
      overflow-y: auto;
    }
    .modal-order-item {
      display: flex;
      justify-content: space-between;
      font-size: .82rem;
      padding: 5px 0;
      border-bottom: 1px dashed var(--beige-dk);
      color: var(--brown);
    }
    .modal-order-item:last-child { border-bottom: none; }
    .modal-actions { display: flex; gap: 12px; }
    .modal-actions .btn { flex: 1; justify-content: center; }

    /* SUCCESS MODAL */
    .success-modal {
      text-align: center;
    }
    .success-modal .success-icon {
      font-size: 4rem;
      margin-bottom: 16px;
      display: block;
    }
    .success-modal h3 { color: var(--olive); margin-bottom: 10px; }
    .success-modal p { font-size: .9rem; color: var(--brown-lt); margin-bottom: 24px; }

    /* =============================
       EXPERIENCE SECTION
    ============================= */
    .experience-section {
      padding: 100px 0;
      background: var(--brown);
      position: relative;
      overflow: hidden;
    }
    .experience-section::before {
      content: '☕';
      position: absolute;
      font-size: 300px;
      opacity: .04;
      right: -40px;
      top: 50%;
      transform: translateY(-50%);
    }
    .exp-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }
    .exp-text .section-title { color: var(--gold); }
    .exp-text .section-title::after { background: var(--olive); }
    .exp-text p {
      color: rgba(232,225,214,.8);
      font-size: .95rem;
      line-height: 1.9;
      font-weight: 300;
      margin-bottom: 20px;
    }
    .exp-stats {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 20px;
      margin-top: 36px;
    }
    .stat {
      text-align: center;
      padding: 24px 12px;
      background: rgba(232,225,214,.05);
      border-radius: var(--radius);
      border: 1px solid rgba(201,168,106,.15);
    }
    .stat-num {
      font-family: 'Playfair Display', serif;
      font-size: 2.2rem;
      color: var(--gold);
      font-weight: 700;
    }
    .stat-label { font-size: .75rem; color: rgba(232,225,214,.5); margin-top: 4px; }
    .exp-image-mock {
      border-radius: var(--radius);
      overflow: hidden;
      position: relative;
      aspect-ratio: 4/5;
      background: linear-gradient(135deg, #3F5A3C 0%, #2E2A26 100%);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .exp-image-mock::before {
      content: '';
      position: absolute;
      inset: 0;
      background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23C9A86A' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    .exp-image-inner {
      font-size: 8rem;
      z-index: 1;
      opacity: .4;
      animation: float 5s ease-in-out infinite;
    }
    .exp-badge {
      position: absolute;
      bottom: 24px;
      right: 24px;
      background: var(--gold);
      color: var(--brown);
      padding: 12px 20px;
      border-radius: 50px;
      font-size: .8rem;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
    }

    /* =============================
       GALLERY
    ============================= */
    .gallery-section {
      padding: 100px 0;
      background: var(--beige);
    }
    .gallery-section .section-header { margin-bottom: 40px; }
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto;
      gap: 14px;
    }
    .gallery-item {
      border-radius: var(--radius-sm);
      overflow: hidden;
      position: relative;
      aspect-ratio: 1;
      background: linear-gradient(135deg, var(--beige-dk), var(--beige));
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
      transition: var(--transition);
    }
    .gallery-item:nth-child(1) { grid-column: span 2; aspect-ratio: 2/1; }
